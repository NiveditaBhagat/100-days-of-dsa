🧪 Code (Clean & Interview-Ready)

class ListNode(object):
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next


class Solution(object):
    def partition(self, head, x):
        before_head = ListNode(0)
        after_head = ListNode(0)

        before = before_head
        after = after_head

        curr = head

        while curr:
            if curr.val < x:
                before.next = curr
                before = before.next
            else:
                after.next = curr
                after = after.next
            curr = curr.next

        after.next = None          # important to avoid cycle
        before.next = after_head.next

        return before_head.next
-------------------------------------------------------------------------------------------------------------------------------------------------
⚠️ Very Important Line
after.next = None

Why?
Original list still has old links
This prevents cycles or wrong connections
